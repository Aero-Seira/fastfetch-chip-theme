{
    // fastfetch chip theme preset
    // Logo + palette generated by tools/gen_logo.py (chip registry: tools/chips.py)
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
        "source": "@LOGO@",
        "padding": { "top": 0, "left": 0, "right": 3 },
        "printRemaining": true,
        "color": {
            "1": "#0C0D11", // $1 die body, near-black
            "2": "#16181E", // $2 dark shade
            "3": "#262931", // $3 mid accent
            "4": "#3A3E49", // $4 accent
            "5": "#5E6B84", // $5 bright accent
            "6": "#93A2BC", // $6 light accent (package rim)
            "7": "#BCBFC9", // $7 pale accent
            "8": "#E3E5EA", // $8 silver       (lettering)
            "9": "#FFFFFF"  // $9 bright silver
        }
    },
    "display": {
        "separator": "  ",
        "color": {
            "keys": "#93A2BC",
            "title": "#E3E5EA",
            "output": "#BCBFC9",
            "separator": "#3A3E49"
        },
        "brightColor": true
    },
    "modules": [
        "title",
        "os",
        "host",
        "kernel",
        "uptime",
        "packages",
        "shell",
        "cpu",
        "gpu",
        "memory",
        "swap",
        "disk",
        "display",
        "battery",
        "poweradapter",
        "terminal",
        "theme",
        "font",
        "locale",
        { "type": "custom", "format": "\u001b[90m▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔\u001b[0m" },
        "colors"
    ]
}
