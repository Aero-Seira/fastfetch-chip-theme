{
    // fastfetch chip theme preset
    // Logo + palette generated by tools/gen_logo.py (chip registry: tools/chips.py)
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
        "source": "@LOGO@",
        "padding": { "top": 0, "left": 0, "right": 3 },
        "printRemaining": true,
        "color": {
            "1": "#090E1A", // $1 die body, near-black
            "2": "#0E1A30", // $2 dark shade
            "3": "#123058", // $3 mid accent
            "4": "#0F68B5", // $4 accent
            "5": "#1E90DE", // $5 bright accent
            "6": "#63B6EE", // $6 light accent (package rim)
            "7": "#9AD0F2", // $7 pale accent
            "8": "#D0E6F6", // $8 silver       (lettering)
            "9": "#F2FAFF"  // $9 bright silver
        }
    },
    "display": {
        "separator": "  ",
        "color": {
            "keys": "#63B6EE",
            "title": "#D0E6F6",
            "output": "#9AD0F2",
            "separator": "#0F68B5"
        },
        "brightColor": true
    },
    "modules": [
        "title",
        "os",
        "host",
        "kernel",
        "uptime",
        "packages",
        "shell",
        "cpu",
        "gpu",
        "memory",
        "swap",
        "disk",
        "display",
        "battery",
        "poweradapter",
        "terminal",
        "theme",
        "font",
        "locale",
        { "type": "custom", "format": "\u001b[90m▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔\u001b[0m" },
        "colors"
    ]
}
