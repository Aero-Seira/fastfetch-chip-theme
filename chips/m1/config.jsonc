{
    // fastfetch chip theme preset
    // Logo + palette generated by tools/gen_logo.py (chip registry: tools/chips.py)
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
        "source": "@LOGO@",
        "padding": { "top": 0, "left": 0, "right": 3 },
        "printRemaining": true,
        "color": {
            "1": "#121417", // $1 die body, near-black
            "2": "#1E2126", // $2 dark shade
            "3": "#363B44", // $3 mid accent
            "4": "#525866", // $4 accent
            "5": "#767E8C", // $5 bright accent
            "6": "#A0A8B8", // $6 light accent (package rim)
            "7": "#C8CFDB", // $7 pale accent
            "8": "#E4E9F1", // $8 silver       (lettering)
            "9": "#FFFFFF"  // $9 bright silver
        }
    },
    "display": {
        "separator": "  ",
        "color": {
            "keys": "#A0A8B8",
            "title": "#E4E9F1",
            "output": "#C8CFDB",
            "separator": "#525866"
        },
        "brightColor": true
    },
    "modules": [
        "title",
        "os",
        "host",
        "kernel",
        "uptime",
        "packages",
        "shell",
        "cpu",
        "gpu",
        "memory",
        "swap",
        "disk",
        "display",
        "battery",
        "poweradapter",
        "terminal",
        "theme",
        "font",
        "locale",
        { "type": "custom", "format": "\u001b[90m▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔\u001b[0m" },
        "colors"
    ]
}
