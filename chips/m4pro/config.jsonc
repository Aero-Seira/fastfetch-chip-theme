{
    // fastfetch chip theme preset
    // Logo + palette generated by tools/gen_logo.py (chip registry: tools/chips.py)
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
        "source": "@LOGO@",
        "padding": { "top": 0, "left": 0, "right": 3 },
        "printRemaining": true,
        "color": {
            "1": "#0A0E1C", // $1 die body, near-black
            "2": "#101A32", // $2 dark shade
            "3": "#1A3068", // $3 mid accent
            "4": "#264EA8", // $4 accent
            "5": "#387AD8", // $5 bright accent
            "6": "#60A8EC", // $6 light accent (package rim)
            "7": "#96C4E4", // $7 pale accent
            "8": "#C8DEEE", // $8 silver       (lettering)
            "9": "#F4FAFF"  // $9 bright silver
        }
    },
    "display": {
        "separator": "  ",
        "color": {
            "keys": "#60A8EC",
            "title": "#C8DEEE",
            "output": "#96C4E4",
            "separator": "#264EA8"
        },
        "brightColor": true
    },
    "modules": [
        "title",
        "os",
        "host",
        "kernel",
        "uptime",
        "packages",
        "shell",
        "cpu",
        "gpu",
        "memory",
        "swap",
        "disk",
        "display",
        "battery",
        "poweradapter",
        "terminal",
        "theme",
        "font",
        "locale",
        { "type": "custom", "format": "\u001b[90m▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔\u001b[0m" },
        "colors"
    ]
}
