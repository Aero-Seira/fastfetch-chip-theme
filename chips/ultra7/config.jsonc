{
    // fastfetch chip theme preset
    // Logo + palette generated by tools/gen_logo.py (chip registry: tools/chips.py)
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
        "source": "@LOGO@",
        "padding": { "top": 0, "left": 0, "right": 3 },
        "printRemaining": true,
        "color": {
            "1": "#0B0E1E", // $1 die body, near-black
            "2": "#151A3C", // $2 dark shade
            "3": "#27306E", // $3 mid accent
            "4": "#3E4CB6", // $4 accent
            "5": "#6372E2", // $5 bright accent
            "6": "#92A4F4", // $6 light accent (package rim)
            "7": "#C0CBF8", // $7 pale accent
            "8": "#E2E7FB", // $8 silver       (lettering)
            "9": "#F8F9FF"  // $9 bright silver
        }
    },
    "display": {
        "separator": "  ",
        "color": {
            "keys": "#92A4F4",
            "title": "#E2E7FB",
            "output": "#C0CBF8",
            "separator": "#3E4CB6"
        },
        "brightColor": true
    },
    "modules": [
        "title",
        "os",
        "host",
        "kernel",
        "uptime",
        "packages",
        "shell",
        "cpu",
        "gpu",
        "memory",
        "swap",
        "disk",
        "display",
        "battery",
        "poweradapter",
        "terminal",
        "theme",
        "font",
        "locale",
        { "type": "custom", "format": "\u001b[90m▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔\u001b[0m" },
        "colors"
    ]
}
