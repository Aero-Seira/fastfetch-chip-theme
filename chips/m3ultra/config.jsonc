{
    // fastfetch chip theme preset
    // Logo + palette generated by tools/gen_logo.py (chip registry: tools/chips.py)
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
        "source": "@LOGO@",
        "padding": { "top": 0, "left": 0, "right": 3 },
        "printRemaining": true,
        "color": {
            "1": "#1D1208", // $1 die body, near-black
            "2": "#33200E", // $2 dark shade
            "3": "#6E4016", // $3 mid accent
            "4": "#B06A24", // $4 accent
            "5": "#DC903C", // $5 bright accent
            "6": "#F0B96E", // $6 light accent (package rim)
            "7": "#F2D8AC", // $7 pale accent
            "8": "#F5E8D2", // $8 silver       (lettering)
            "9": "#FFF9EE"  // $9 bright silver
        }
    },
    "display": {
        "separator": "  ",
        "color": {
            "keys": "#F0B96E",
            "title": "#F5E8D2",
            "output": "#F2D8AC",
            "separator": "#B06A24"
        },
        "brightColor": true
    },
    "modules": [
        "title",
        "os",
        "host",
        "kernel",
        "uptime",
        "packages",
        "shell",
        "cpu",
        "gpu",
        "memory",
        "swap",
        "disk",
        "display",
        "battery",
        "poweradapter",
        "terminal",
        "theme",
        "font",
        "locale",
        { "type": "custom", "format": "\u001b[90m▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔\u001b[0m" },
        "colors"
    ]
}
