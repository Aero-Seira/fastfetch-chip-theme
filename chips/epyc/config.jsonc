{
    // fastfetch chip theme preset
    // Logo + palette generated by tools/gen_logo.py (chip registry: tools/chips.py)
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
        "source": "@LOGO@",
        "padding": { "top": 0, "left": 0, "right": 3 },
        "printRemaining": true,
        "color": {
            "1": "#07110C", // $1 die body, near-black
            "2": "#0C2016", // $2 dark shade
            "3": "#13442C", // $3 mid accent
            "4": "#1A6E44", // $4 accent
            "5": "#24A060", // $5 bright accent
            "6": "#46C886", // $6 light accent (package rim)
            "7": "#8EE2B4", // $7 pale accent
            "8": "#C4F0D6", // $8 silver       (lettering)
            "9": "#EFFAF2"  // $9 bright silver
        }
    },
    "display": {
        "separator": "  ",
        "color": {
            "keys": "#46C886",
            "title": "#C4F0D6",
            "output": "#8EE2B4",
            "separator": "#1A6E44"
        },
        "brightColor": true
    },
    "modules": [
        "title",
        "os",
        "host",
        "kernel",
        "uptime",
        "packages",
        "shell",
        "cpu",
        "gpu",
        "memory",
        "swap",
        "disk",
        "display",
        "battery",
        "poweradapter",
        "terminal",
        "theme",
        "font",
        "locale",
        { "type": "custom", "format": "\u001b[90m▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔\u001b[0m" },
        "colors"
    ]
}
