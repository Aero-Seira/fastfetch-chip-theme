{
    // fastfetch chip theme preset
    // Logo + palette generated by tools/gen_logo.py (chip registry: tools/chips.py)
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
        "source": "@LOGO@",
        "padding": { "top": 0, "left": 0, "right": 3 },
        "printRemaining": true,
        "color": {
            "1": "#1C0C06", // $1 die body, near-black
            "2": "#321608", // $2 dark shade
            "3": "#662A0E", // $3 mid accent
            "4": "#A84814", // $4 accent
            "5": "#D86A1E", // $5 bright accent
            "6": "#F2924E", // $6 light accent (package rim)
            "7": "#F6BC8E", // $7 pale accent
            "8": "#FADDC4", // $8 silver       (lettering)
            "9": "#FFF6EC"  // $9 bright silver
        }
    },
    "display": {
        "separator": "  ",
        "color": {
            "keys": "#F2924E",
            "title": "#FADDC4",
            "output": "#F6BC8E",
            "separator": "#A84814"
        },
        "brightColor": true
    },
    "modules": [
        "title",
        "os",
        "host",
        "kernel",
        "uptime",
        "packages",
        "shell",
        "cpu",
        "gpu",
        "memory",
        "swap",
        "disk",
        "display",
        "battery",
        "poweradapter",
        "terminal",
        "theme",
        "font",
        "locale",
        { "type": "custom", "format": "\u001b[90m▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔\u001b[0m" },
        "colors"
    ]
}
