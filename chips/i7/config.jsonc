{
    // fastfetch chip theme preset
    // Logo + palette generated by tools/gen_logo.py (chip registry: tools/chips.py)
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
        "source": "@LOGO@",
        "padding": { "top": 0, "left": 0, "right": 3 },
        "printRemaining": true,
        "color": {
            "1": "#0A0C1C", // $1 die body, near-black
            "2": "#121632", // $2 dark shade
            "3": "#1E2660", // $3 mid accent
            "4": "#2E3FAE", // $4 accent
            "5": "#4B62D8", // $5 bright accent
            "6": "#7B8FEC", // $6 light accent (package rim)
            "7": "#AEB9F2", // $7 pale accent
            "8": "#D3DAF6", // $8 silver       (lettering)
            "9": "#F4F6FF"  // $9 bright silver
        }
    },
    "display": {
        "separator": "  ",
        "color": {
            "keys": "#7B8FEC",
            "title": "#D3DAF6",
            "output": "#AEB9F2",
            "separator": "#2E3FAE"
        },
        "brightColor": true
    },
    "modules": [
        "title",
        "os",
        "host",
        "kernel",
        "uptime",
        "packages",
        "shell",
        "cpu",
        "gpu",
        "memory",
        "swap",
        "disk",
        "display",
        "battery",
        "poweradapter",
        "terminal",
        "theme",
        "font",
        "locale",
        { "type": "custom", "format": "\u001b[90m▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔\u001b[0m" },
        "colors"
    ]
}
