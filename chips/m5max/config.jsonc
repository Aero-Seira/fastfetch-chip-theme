{
    // fastfetch chip theme preset
    // Logo + palette generated by tools/gen_logo.py (chip registry: tools/chips.py)
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
        "source": "@LOGO@",
        "padding": { "top": 0, "left": 0, "right": 3 },
        "printRemaining": true,
        "color": {
            "1": "#140E20", // $1 die body, near-black
            "2": "#201638", // $2 dark shade
            "3": "#3E2A6E", // $3 mid accent
            "4": "#5F40AE", // $4 accent
            "5": "#8A64DC", // $5 bright accent
            "6": "#B296EE", // $6 light accent (package rim)
            "7": "#D2C2F2", // $7 pale accent
            "8": "#E7DFF7", // $8 silver       (lettering)
            "9": "#FBF8FF"  // $9 bright silver
        }
    },
    "display": {
        "separator": "  ",
        "color": {
            "keys": "#B296EE",
            "title": "#E7DFF7",
            "output": "#D2C2F2",
            "separator": "#5F40AE"
        },
        "brightColor": true
    },
    "modules": [
        "title",
        "os",
        "host",
        "kernel",
        "uptime",
        "packages",
        "shell",
        "cpu",
        "gpu",
        "memory",
        "swap",
        "disk",
        "display",
        "battery",
        "poweradapter",
        "terminal",
        "theme",
        "font",
        "locale",
        { "type": "custom", "format": "\u001b[90m▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔\u001b[0m" },
        "colors"
    ]
}
