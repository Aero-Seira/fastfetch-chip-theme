{
    // fastfetch chip theme preset
    // Logo + palette generated by tools/gen_logo.py (chip registry: tools/chips.py)
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
        "source": "@LOGO@",
        "padding": { "top": 0, "left": 0, "right": 3 },
        "printRemaining": true,
        "color": {
            "1": "#0A101C", // $1 die body, near-black
            "2": "#0F1C30", // $2 dark shade
            "3": "#17345C", // $3 mid accent
            "4": "#1F5C9E", // $4 accent
            "5": "#2E8CD8", // $5 bright accent
            "6": "#5FB4EE", // $6 light accent (package rim)
            "7": "#9CD2F2", // $7 pale accent
            "8": "#CDE6F8", // $8 silver       (lettering)
            "9": "#F0F9FF"  // $9 bright silver
        }
    },
    "display": {
        "separator": "  ",
        "color": {
            "keys": "#5FB4EE",
            "title": "#CDE6F8",
            "output": "#9CD2F2",
            "separator": "#1F5C9E"
        },
        "brightColor": true
    },
    "modules": [
        "title",
        "os",
        "host",
        "kernel",
        "uptime",
        "packages",
        "shell",
        "cpu",
        "gpu",
        "memory",
        "swap",
        "disk",
        "display",
        "battery",
        "poweradapter",
        "terminal",
        "theme",
        "font",
        "locale",
        { "type": "custom", "format": "\u001b[90m▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔\u001b[0m" },
        "colors"
    ]
}
