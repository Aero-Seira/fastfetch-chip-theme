{
    // fastfetch chip theme preset
    // Logo + palette generated by tools/gen_logo.py (chip registry: tools/chips.py)
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
        "source": "@LOGO@",
        "padding": { "top": 0, "left": 0, "right": 3 },
        "printRemaining": true,
        "color": {
            "1": "#180C05", // $1 die body, near-black
            "2": "#2B1609", // $2 dark shade
            "3": "#562E0E", // $3 mid accent
            "4": "#944E15", // $4 accent
            "5": "#C4701E", // $5 bright accent
            "6": "#EA9A48", // $6 light accent (package rim)
            "7": "#F4C48C", // $7 pale accent
            "8": "#F9E2C6", // $8 silver       (lettering)
            "9": "#FFF6EA"  // $9 bright silver
        }
    },
    "display": {
        "separator": "  ",
        "color": {
            "keys": "#EA9A48",
            "title": "#F9E2C6",
            "output": "#F4C48C",
            "separator": "#944E15"
        },
        "brightColor": true
    },
    "modules": [
        "title",
        "os",
        "host",
        "kernel",
        "uptime",
        "packages",
        "shell",
        "cpu",
        "gpu",
        "memory",
        "swap",
        "disk",
        "display",
        "battery",
        "poweradapter",
        "terminal",
        "theme",
        "font",
        "locale",
        { "type": "custom", "format": "\u001b[90m▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔\u001b[0m" },
        "colors"
    ]
}
