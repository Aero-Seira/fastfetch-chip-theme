{
    // fastfetch chip theme preset
    // Logo + palette generated by tools/gen_logo.py (chip registry: tools/chips.py)
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
        "source": "@LOGO@",
        "padding": { "top": 0, "left": 0, "right": 3 },
        "printRemaining": true,
        "color": {
            "1": "#0B0D12", // $1 die body, near-black
            "2": "#151A24", // $2 dark shade
            "3": "#242E3E", // $3 mid accent
            "4": "#35455E", // $4 accent
            "5": "#4E6382", // $5 bright accent
            "6": "#7E94B2", // $6 light accent (package rim)
            "7": "#B4C4D6", // $7 pale accent
            "8": "#E2EAF2", // $8 silver       (lettering)
            "9": "#FAFCFF"  // $9 bright silver
        }
    },
    "display": {
        "separator": "  ",
        "color": {
            "keys": "#7E94B2",
            "title": "#E2EAF2",
            "output": "#B4C4D6",
            "separator": "#35455E"
        },
        "brightColor": true
    },
    "modules": [
        "title",
        "os",
        "host",
        "kernel",
        "uptime",
        "packages",
        "shell",
        "cpu",
        "gpu",
        "memory",
        "swap",
        "disk",
        "display",
        "battery",
        "poweradapter",
        "terminal",
        "theme",
        "font",
        "locale",
        { "type": "custom", "format": "\u001b[90m▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔\u001b[0m" },
        "colors"
    ]
}
